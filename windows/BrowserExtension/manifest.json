{
  "manifest_version": 3,
  "name": "Save to Recall",
  "description": "Clip web pages, hero images, and prices directly into Recall for Windows.",
  "version": "1.0.0",
  "icons": {
    "48": "icon.png"
  },
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Save to Recall",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
