<Window x:Class="Recall.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recall" 
        Height="840" 
        Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar -->
        <Grid Grid.Row="0" Margin="24,18,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo & Title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🧠" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Recall" FontWeight="SemiBold" FontSize="18" Foreground="#F8FAFC" VerticalAlignment="Center" />
                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Windows" FontSize="11" Foreground="#94A3B8" />
                </Border>
            </StackPanel>

            <!-- Mode Selector Tabs -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="TabEverything" Content="Everything" Background="#6366F1" Foreground="White" Padding="14,6" Margin="4,0" Click="OnTabEverythingClicked" />
                <Button x:Name="TabTopMind" Content="❤️ Top of Mind" Background="#1E293B" Foreground="#E2E8F0" Padding="14,6" Margin="4,0" Click="OnTabTopMindClicked" />
                <Button x:Name="TabSerendipity" Content="✨ Serendipity" Background="#1E293B" Foreground="#E2E8F0" Padding="14,6" Margin="4,0" Click="OnTabSerendipityClicked" />
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnNewNote" Content="✏️ New Note" Background="#1E293B" Foreground="#E2E8F0" Padding="12,6" Margin="0,0,8,0" Click="OnNewNoteClicked" />
                <Button x:Name="BtnImportFile" Content="➕ Add File" Background="#1E293B" Foreground="#E2E8F0" Padding="12,6" Click="OnImportFileClicked" />
            </StackPanel>
        </Grid>

        <!-- 2. Search Bar -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <TextBox x:Name="SearchBox"
                     FontSize="15"
                     Padding="14,10"
                     Background="#1E293B"
                     Foreground="White"
                     BorderBrush="#334155"
                     BorderThickness="1"
                     TextChanged="OnSearchTextChanged">
            </TextBox>
            <TextBlock Text="Alt + Space" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center" 
                       Margin="0,0,16,0" 
                       Foreground="#64748B" 
                       FontSize="12" 
                       IsHitTestVisible="False" />
        </Grid>

        <!-- 3. Drag & Drop Canvas -->
        <Grid Grid.Row="2" Margin="24,0,24,12">
            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Visibility="Collapsed">
                <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="Drop any image, screenshot, or PDF here" FontWeight="SemiBold" FontSize="16" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Or use Alt + Space to invoke Recall instantly" Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Grid of Memory Cards -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CardsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="280" 
                                    Margin="8" 
                                    Background="#1E293B" 
                                    BorderBrush="#334155" 
                                    BorderThickness="1" 
                                    CornerRadius="10"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnCardClicked">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="180" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail Image -->
                                    <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Card Metadata Footer -->
                                    <StackPanel Grid.Row="1" Margin="12">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Item.Name}" 
                                                       FontWeight="Medium" 
                                                       FontSize="13" 
                                                       Foreground="#F8FAFC"
                                                       TextTrimming="CharacterEllipsis" 
                                                       VerticalAlignment="Center" 
                                                       Margin="0,0,24,0" />
                                            <Button Content="❤️" 
                                                    HorizontalAlignment="Right" 
                                                    Padding="4,2" 
                                                    Background="Transparent" 
                                                    BorderThickness="0"
                                                    Foreground="#EF4444"
                                                    Click="OnToggleFavoriteClicked" 
                                                    Tag="{Binding Item.Id}" />
                                        </Grid>

                                        <!-- Tags & Match Reason -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#4338CA" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Item.Kind}" FontSize="10" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding MatchReason}" 
                                                       FontSize="11" 
                                                       Foreground="#94A3B8" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 4. Status Bar -->
        <Grid Grid.Row="3" Background="#070A10" Margin="0">
            <TextBlock x:Name="StatusTextBlock" Margin="24,8" Text="Recall Ready • 100% Local &amp; Private • DirectML GPU Acceleration" FontSize="11" Foreground="#64748B" />
        </Grid>

        <!-- 5. Modal Overlay for Quick Note -->
        <Grid x:Name="NoteModalGrid" Visibility="Collapsed" Background="#90000000" Grid.RowSpan="4">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Create Quick Note" FontWeight="SemiBold" FontSize="16" Foreground="#F8FAFC" Margin="0,0,0,16" />
                    <TextBlock Text="Title" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6" />
                    <TextBox x:Name="NoteTitleBox" Padding="10,8" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,0,16" />
                    <TextBlock Text="Content (Markdown supported)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6" />
                    <TextBox x:Name="NoteContentBox" AcceptsReturn="True" TextWrapping="Wrap" Height="120" Padding="10,8" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,20,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Background="#334155" Foreground="White" Padding="16,8" Margin="0,0,8,0" Click="OnCancelNoteClicked" />
                        <Button Content="Save Note" Background="#6366F1" Foreground="White" Padding="16,8" Click="OnSaveNoteClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>